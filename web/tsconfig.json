{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["vitest/globals"],
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/lib/mono/mono": [
            "../shared/mono/mono"
      ],
      "@/lib/mono/mono-work": [
            "../shared/mono/mono-work"
      ],
      "@/lib/mono/mono-insights": [
            "../shared/mono/mono-insights"
      ],
      "@/lib/mono/mono-rules": [
            "../shared/mono/mono-rules"
      ],
      "@/lib/mono/mono-shape": [
            "../shared/mono/mono-shape"
      ],
      "@/lib/mono/spend-viz": [
            "../shared/mono/spend-viz"
      ],
      "@/lib/import/ics": [
            "../shared/calendar/ics"
      ],
      "@/*": [
            "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts",
    "../shared/**/*.ts"
  ],
  "exclude": ["node_modules", "out", "scripts"]
}
