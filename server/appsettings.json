{
  // Console only. The file sink wrote to a relative path inside a container
  // whose working directory belongs to root while the app runs unprivileged,
  // so Serilog caught the open failure and silently substituted a null sink —
  // half this configuration was dead, and its fourteen-file retention governed
  // nothing. Had it worked it would have been worse: no volume is mounted for
  // it, so it would have filled the container's writable layer. Docker rotates
  // the console stream, and compose.prod.yaml now says how much it may keep.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Shifter"
    }
  },

  "TokenOptions": {
    "Key": "",
    "Issuer": "Shifter",
    "Audience": "User",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },

  "Google": {
    // Public by design: the app hands this to every browser that opens the
    // sign-in page. The client secret from the same credentials file is not
    // used at all — this flow validates an ID token rather than exchanging a
    // code, so there is nothing here to keep out of the repository.
    "ClientId": "438164399656-djouapgvcnfofer77l7dm41h7dptpcjv.apps.googleusercontent.com"
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "AllowedHosts": "*"
}
