# One line decides everything. SITE_ADDRESS of ":80" serves plain HTTP, which
# is all a bare IP can do. Put a hostname there instead and Caddy obtains and
# renews a Let's Encrypt certificate on its own — no certbot, no cron, no
# reload. That is the whole reason it is here rather than nginx.
{$SITE_ADDRESS} {
	encode zstd gzip

	# The app is the only backend; it serves both the API and the SPA.
	reverse_proxy shifter:8080 {
		health_uri /health

		# Ten seconds rather than thirty, because this interval decides how long
		# a recovered backend keeps being treated as down. At thirty, a restart
		# that finished in fifteen seconds still looked broken for another
		# fifteen — which is most of the outage below, and none of it real.
		health_interval 10s

		# A deploy stops the old container before the new one answers, and with
		# one replica that leaves no healthy upstream for around half a minute.
		# Without these, every request in that window is a 502: the release is
		# fine, but anyone using the site at that moment sees it break. Holding
		# the request turns the outage into a pause — the connection waits, the
		# new container comes up, and the answer arrives late rather than not at
		# all. Forty-five seconds covers a slow start with room to spare and
		# still gives up before a tab looks hung for good.
		lb_try_duration 45s
		lb_try_interval 500ms
	}

	header {
		# The SPA and API are same-origin, so nothing external is needed.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# ==== Caching ====
	#
	# Nothing here sent Cache-Control at all, which does not mean "do not
	# cache" — with only an ETag and a Last-Modified to go on, browsers fall
	# back to a heuristic and keep the file for a fraction of its age without
	# asking again. For a service worker that is close to fatal: a stale sw.js
	# is never re-fetched, so it never updates, and it goes on serving the
	# bundle it cached the first time. The site then looks frozen at an old
	# release while the server has been shipping new ones for days.

	# The entry points, which must be checked every single time. no-cache does
	# not forbid storing them — it requires revalidation, so an unchanged file
	# still costs a 304 rather than a download.
	@entry path / /index.html /sw.js /manifest.webmanifest
	header @entry Cache-Control "no-cache"

	# Hashed builds, where the name changes whenever the contents do. These are
	# the ones worth keeping for a year: a new release asks for new names, so a
	# stale copy can never be served for them.
	@hashed path_regexp \-[A-Z0-9]{8}\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}
}
