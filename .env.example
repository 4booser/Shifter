# Copy to .env and fill in. compose reads it automatically; .env is git-ignored.

# ==== Required ====

# Token signing key. Generate one:  openssl rand -base64 48
# A Release build refuses to start without it, on purpose.
SHIFTER_JWT_KEY=

# Password for the shifter_user role inside the Postgres container.
# Applied once, when the volume is created. To change it later:
#   docker compose down -v   (this deletes the database)
POSTGRES_PASSWORD=

# Production only, read by compose.prod.yaml. ":80" serves plain HTTP, which is
# all a bare IP can do. Put a hostname here instead and Caddy obtains and renews
# a certificate on its own.
SITE_ADDRESS=:80

# ==== Optional ====

# Where the database is published on the host. Not 5432 by default: a Postgres
# installed on the machine usually holds that, and the container would fail to
# bind rather than quietly move.
POSTGRES_PORT=5433

# Where the app is published on the host.
APP_PORT=8080

# The Google client id lives in server/appsettings.json, ships in the image and
# is picked up on its own — neither compose file reads it from here. Pointing an
# environment at a different Google project means adding Google__ClientId to
# that stack's environment by hand; setting it blank would switch the sign-in
# button off, which is why nothing does it automatically.

# ==== Integrations, all optional ====
#
# Every one of these is designed to degrade silently when unset: no key, no
# feature, no crash. Which is exactly why they need writing down — a server
# rebuilt from the README came up with push notifications, password recovery
# mail, Telegram, the assistant, the schedule reader and offsite backups all
# quietly off, and nothing anywhere said so. The status page lists what is
# missing; this list says what to set.

# Web push. Generate a pair with docker/setup-vapid.sh — without both, the
# notification settings simply do not appear.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Reading a photographed rota. Anthropic; billed per image, capped per person
# per day in the app's own settings.
ANTHROPIC_API_KEY=

# The assistant and the daily brief. Gemini Flash-Lite.
GEMINI_API_KEY=

# The Telegram bot: "сегодня", "неделя", "начал". Both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Password-recovery mail, through Resend. Without these a forgotten password
# cannot be reset at all, which is the one degradation here that hurts.
RESEND_API_KEY=
MAIL_FROM=

# A command run after each nightly dump, with the dump's directory as its only
# argument — for example "rclone copy --to backup:shifter". Unset means the
# backups never leave the machine they are protecting, which is not a backup.
OFFSITE_CMD=
